<%- include('partials/head', { title: 'Register' }) %>
<body>
    <%- include('partials/navbar', { active: 'register' }) %>

    <main class="page">
        <div class="container">
            <div class="auth-wrap">
                <aside class="auth-side">
                    <img src="/bus2.png" alt="">
                    <h2>Join BusPass</h2>
                    <p>Create your account to start applying for monthly bus passes.</p>
                    <ul>
                        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>30-day passes on 3 routes</li>
                        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Instant QR code pass</li>
                        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>No paperwork, no queues</li>
                    </ul>
                </aside>

                <div class="auth-form">
                    <h1>Create your account</h1>
                    <p class="sub">It only takes a minute. You must be 13 or older.</p>

                    <form action="/register" method="POST">
                        <div class="form-grid">
                            <div class="field full">
                                <label for="name">Full name</label>
                                <input type="text" id="name" name="name" placeholder="Rahul Sharma" autocomplete="name" required>
                            </div>
                            <div class="field">
                                <label for="age">Age</label>
                                <input type="number" id="age" name="age" placeholder="21" min="1" max="120" inputmode="numeric" required>
                            </div>
                            <div class="field">
                                <label for="contact">Contact number</label>
                                <input type="tel" id="contact" name="contact" placeholder="98765 43210" autocomplete="tel" required>
                            </div>
                            <div class="field full">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
                            </div>
                            <div class="field">
                                <label for="username">Username</label>
                                <input type="text" id="username" name="username" placeholder="rahul21" autocomplete="username" required>
                            </div>
                            <div class="field">
                                <label for="password">Password</label>
                                <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" required>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary btn-block btn-lg">Create account</button>
                        </div>
                    </form>

                    <p class="switch">Already have an account? <a href="/login">Log in</a></p>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
