<%- include('partials/head', { title: 'Home' }) %>
<body>
    <%- include('partials/navbar', { active: 'home' }) %>

    <main>
        <section class="hero">
            <div class="container hero-grid">
                <div>
                    <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Monthly passes now available online</span>
                    <h1>Your bus pass, <span class="accent">without the queue.</span></h1>
                    <p class="lead">Register once, choose your route, pay and get a 30-day bus pass with a scannable QR code. It all takes a few minutes.</p>
                    <div class="hero-actions">
                        <a href="/register" class="btn btn-primary btn-lg">
                            Get Started
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                        </a>
                        <a href="/login" class="btn btn-outline btn-lg">I already have an account</a>
                    </div>
                    <div class="hero-stats">
                        <div><strong>3</strong><span>Active routes</span></div>
                        <div><strong>30 days</strong><span>Pass validity</span></div>
                        <div><strong>Instant</strong><span>QR pass</span></div>
                    </div>
                </div>
                <div class="hero-media">
                    <img src="/bus_image.png" alt="A row of red double-decker buses parked along a tree-lined street">
                    <div class="hero-badge">
                        <span class="icon-circle" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        </span>
                        <div>
                            <strong>Pass generated</strong>
                            <span>Valid for the next 30 days</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section section-alt" aria-labelledby="how-title">
            <div class="container">
                <div class="section-head">
                    <h2 id="how-title">How it works</h2>
                    <p>Four simple steps from sign-up to boarding.</p>
                </div>
                <div class="grid-4">
                    <div class="step">
                        <span class="step-num">01</span>
                        <h3>Create an account</h3>
                        <p>Register with your name, age, contact and email.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">02</span>
                        <h3>Add passenger details</h3>
                        <p>Log in and choose the route you travel on.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">03</span>
                        <h3>Pay for your pass</h3>
                        <p>Review the fare and confirm your payment.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">04</span>
                        <h3>Get your QR pass</h3>
                        <p>Show the QR code to the conductor when you board.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" aria-labelledby="routes-title">
            <div class="container">
                <div class="section-head">
                    <h2 id="routes-title">Available routes</h2>
                    <p>Monthly pass fares for each route.</p>
                </div>
                <div class="grid-3">
                    <div class="route-card">
                        <div class="route-line"><span>Pune</span><span class="dash" aria-hidden="true"></span><span>Solapur</span></div>
                        <div class="route-price"><span>30-day pass</span><strong>Rs. 1500</strong></div>
                    </div>
                    <div class="route-card">
                        <div class="route-line"><span>Solapur</span><span class="dash" aria-hidden="true"></span><span>Pandharpur</span></div>
                        <div class="route-price"><span>30-day pass</span><strong>Rs. 1800</strong></div>
                    </div>
                    <div class="route-card">
                        <div class="route-line"><span>Solapur</span><span class="dash" aria-hidden="true"></span><span>Nashik</span></div>
                        <div class="route-price"><span>30-day pass</span><strong>Rs. 2000</strong></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" style="padding-top: 0;">
            <div class="container">
                <div class="cta-banner">
                    <div>
                        <h2>Ready to ride?</h2>
                        <p>Create your free account and get your first pass today.</p>
                    </div>
                    <a href="/register" class="btn btn-primary btn-lg">Create account</a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
