<%- include('partials/head', { title: 'QR Code Generator' }) %>
<body>
    <%- include('partials/navbar', { active: 'scan' }) %>

    <main class="page">
        <div class="container">
            <div class="card card-narrow">
                <div class="feature-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/></svg>
                </div>
                <h1>QR code generator</h1>
                <p class="sub">Turn any text or URL into a QR code.</p>

                <form action="/scan" method="post">
                    <div class="field">
                        <label for="text">Text or URL</label>
                        <textarea name="text" id="text" placeholder="https://example.com or any text" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg">Generate QR Code</button>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
